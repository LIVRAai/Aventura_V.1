{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "routes": [
    {
      "src": "^/$",
      "dest": "/landing.html"
    },
    {
      "src": "^/prueba/?$",
      "dest": "/trial.html"
    },
    {
      "src": "^/app/?$",
      "dest": "/index.html"
    },
    {
      "handle": "filesystem"
    }
  ]
}
